# Copy to .env and fill in from Firebase console > Project settings > Your apps.
# These are public-by-design client keys (EXPO_PUBLIC_* are baked into the
# client bundle). Membership is enforced by firestore.rules, not key secrecy.
# Never commit .env.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: one LLM call per baby profile for personalized starting guidelines
# (age + location only — never names). Without it, the app uses the built-in
# guideline table — no key needed, fully offline-capable.
EXPO_PUBLIC_OPENAI_API_KEY=
# Optional: override the model used for guideline generation.
# EXPO_PUBLIC_GUIDELINES_MODEL=gpt-4o-mini
